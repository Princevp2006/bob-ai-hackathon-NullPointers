# PowerGuard AI — Environment Variable Template
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ── Flask ──────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=development
FLASK_DEBUG=true
FLASK_APP=src/backend/app.py

# ── Database ───────────────────────────────────────────────────
# Leave empty to use the default path: data/powerguard.db
DATABASE_PATH=

# ── ML ─────────────────────────────────────────────────────────
# Leave empty to use the default: src/ml/models/artifacts/
MODEL_DIR=

# ── External APIs (optional) ───────────────────────────────────
# Sign up at https://openweathermap.org/api for a free key
OPENWEATHER_API_KEY=

# ── Risk Thresholds ────────────────────────────────────────────
HIGH_RISK_THRESHOLD=0.7
MEDIUM_RISK_THRESHOLD=0.4
